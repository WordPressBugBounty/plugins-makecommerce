<div class="row g-3">

    <div class="col-12">
        <label for="mc_api_mode" class="form-label d-block">Sandbox</label>
        <input type="checkbox"
               data-toggle="toggle"
               data-onlabel=" "
               data-offlabel=" "
               data-onstyle="success"
               data-size="xs"
               data-width="50"
               data-height="15"
               data-style="custom"
               id="mc_api_mode"
               name="mc_api_mode"
               value="test"
               {% if apiMode == 'test' %}checked{% endif %} />
    </div>

    <div class="col-12">
        <label for="shopId" class="form-label">{{ __('Shop ID', 'wc_makecommerce_domain') }}</label>
        <input type="text" class="form-control" name="shopId"
               value="{{ shopId }}"
               data-live="{{ shopId }}"
               data-test="{{ testShopId }}"
               placeholder="f7741ab2-7445-45f9-9af4-0d0408ef1e4c"
               id="shopId" required>
        <div class="invalid-feedback">
            {{ __('Valid shop ID is required.', 'wc_makecommerce_domain') }}
        </div>
    </div>

    <div class="col-12">
        <label for="secretKey" class="form-label">{{ __('Secret key', 'wc_makecommerce_domain') }}</label>
        <input type="text" class="form-control" name="secretKey"
               value="{{ secretKey }}"
               data-live="{{ secretKey }}"
               data-test="{{ testSecretKey }}"
               placeholder="pfOsGD9oPaFEILwqFLHEHkPf7vZz4j3t36nAcufP1abqT9l99koyuC1IWAOcBeqt"
               id="secretKey" required>
        <div class="invalid-feedback">
            {{ __('Valid secret key is required.', 'wc_makecommerce_domain') }}
        </div>
    </div>

    <div class="col-12">
        <label for="publicKey" class="form-label">{{ __('Public key', 'wc_makecommerce_domain') }}</label>
        <input type="text" class="form-control" name="publicKey"
               value="{{ publicKey }}"
               data-live="{{ publicKey }}"
               data-test="{{ testPublicKey }}"
               placeholder="zPA6jCTIvGKYqrXxlgkXLzv3F82Mjv2E"
               id="publicKey" required>
        <div class="invalid-feedback">
            {{ __('Valid public key is required.', 'wc_makecommerce_domain') }}
        </div>
    </div>
</div>

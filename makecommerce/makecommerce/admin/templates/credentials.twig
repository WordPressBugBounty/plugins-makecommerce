{% extends "base.twig" %}

{% block content %}
<div class="pt-5 text-center">
    <img class="d-block mx-auto mb-4" src="{{ s3_path }}img/woocommerce/mc.svg" alt="" width="72" height="57">
    <h2>MakeCommerce</h2>
    <p class="lead">
        {{ __('An account is required to continue, you can find the credentials under', 'wc_makecommerce_domain') }}
        <br>
        {{ __('Settings->API Settings in our', 'wc_makecommerce_domain') }}
        <a href="https://merchant.maksekeskus.ee" target="_blank">
            {{ __('merchant portal', 'wc_makecommerce_domain') }}
        </a>!
    </p>
    <a class="btn btn-outline-success" href="https://merchant.maksekeskus.ee/sign-up.html?locale=en" target="_blank" role="button">
        {{ __('Sign Up', 'wc_makecommerce_domain') }}
    </a>
</div>

<div class="row">
    <div class="offset-3 col-6 g-3">
        <form class="needs-validation" method="post" novalidate>

            {% include 'credentialsContent.twig' %}

            {%if shopException != ''%}
                <hr class="my-4">
                <div class="alert alert-warning" role="alert">
                    {{ shopException }}
                </div>
            {% endif %}

            <hr class="my-4">

            <button class="w-100 btn btn-primary btn-lg" type="submit" name="save_credentials" value="mc_credentials">{{ __('Submit', 'wc_makecommerce_domain') }}</button>
        </form>
    </div>
</div>
{% endblock %}
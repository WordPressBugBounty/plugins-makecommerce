{% extends "base.twig" %}

{% block content %}
<div class="modal fade" id="makecommerceCredentialsModal" tabindex="-1" aria-hidden="true" data-autoshow="{{ showModal == 'on' ? 1 : 0 }}">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ __('Shop Credentials', 'wc_makecommerce_domain') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-12 g-5">
                    <form class="needs-validation" method="post" novalidate>

                        {% include 'credentialsContent.twig' %}

                        {%if shopException != ''%}
                            <hr class="my-4">
                            <div class="alert alert-warning" role="alert">
                                {{ shopException }}
                            </div>
                        {% endif %}

                        <hr class="my-4">

                        <button class="w-100 btn btn-primary btn-lg" type="submit" name="save_credentials" value="mc_credentials">{{ __('Submit', 'wc_makecommerce_domain') }}</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
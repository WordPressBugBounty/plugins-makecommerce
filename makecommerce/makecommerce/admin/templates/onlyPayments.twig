{% extends "base.twig" %}

{% block content %}
    <div class="text-center">
        <div class="pt-5 text-center">
            <img class="d-block mx-auto mb-4" src="{{ s3_path }}img/woocommerce/mc.svg" alt="" width="72" height="57">
            <h2>MakeCommerce</h2>
            <p class="lead pt-3">
                <br>
                {{ __('All set up to accept payments with MakeCommerce!', 'wc_makecommerce_domain') }}
                <br>
            </p>
            <div>
                <a href="{{ configure_url }}" class="p-0 m-0 align-baseline" style="font-size: 0.9rem; text-decoration: underline;">
                    Woocommerce {{ __('configuration', 'wc_makecommerce_domain') }}
                </a>
            </div>
            <div>
                <button
                        type="button"
                        id="mc-shop-credentials"
                        class="p-0 m-0 align-baseline"
                        style="font-size: 0.9rem; text-decoration: underline; background: none; border: none; color: #0d6efd; cursor: pointer;">
                    {{ __('Shop credentials', 'wc_makecommerce_domain') }}
                </button>
            </div>
        </div>
    </div>
{% endblock %}